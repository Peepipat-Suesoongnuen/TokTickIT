# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
# Dedicated test database for isolated integration tests (tests.md §5).
# REQUIRED for any test run: under NODE_ENV=test the server fails closed
# (Issue #57) instead of silently falling back to the development database.
# Prisma CLI reads DATABASE_URL from schema.prisma, so prepare the test database with:
#   DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit_test?schema=public" npx prisma migrate deploy
#   DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit_test?schema=public" npx prisma db seed
# Validate up front (used by CI before migrate/seed):
#   npx tsx prisma/guard-test-target.ts
TEST_DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit_test?schema=public"
PORT=3000
# Lab 3 auth — approved browser origins for credentialed CORS + the
# state-changing Origin policy (comma-separated, exact match, no "*").
# When unset, the local-dev defaults "http://localhost:5173,http://localhost:5174" apply
# (Vite dev port 5173 + README/e2e port 5174).
APP_ORIGINS="http://localhost:5173,http://localhost:5174"
# IP-level login rate limiting (deployment configuration; numeric
# threshold/window consumed by a later auth task — placeholders only).
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
