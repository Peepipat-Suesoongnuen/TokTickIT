// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  REOPENED
  CLOSED
  CANCELLED
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum ItPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ---------------------------------------------------------------------------
// Lab 1 — Category (retained, evolved in Lab 2 with isActive)
// ---------------------------------------------------------------------------
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Lab 2 — DevelopmentRequester: frozen legacy (scalar fields only, NO
// tickets back-relation). Sunset at the #45/#46 auth cutover, which drops this
// table together with the requester-selector routes.
// ---------------------------------------------------------------------------
model DevelopmentRequester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Lab 2 — Related System
// ---------------------------------------------------------------------------
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Lab 2 — Ticket
// ---------------------------------------------------------------------------
model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int
  // Owner-eligibility enforcement deferred: #48 owner mutations + #50 admin
  // safety via the shared BR-76 invariant — NOT claimed complete in #44.
  ticketOwnerId     Int?
  summary           String
  description       String            @db.Text
  requestedPriority RequestedPriority
  itPriority        ItPriority
  currentStatus     TicketStatus      @default(NEW)
  requesterResolutionIndicatedAt DateTime?
  // Lab 4 (Issue #77) — persistent current resolution cycle, sole source of
  // truth for the resolution gate. Default 1 backfills all existing Tickets.
  resolutionCycle   Int               @default(1)
  ticketDate        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  requester     User @relation("TicketRequester", fields: [requesterId], references: [id])
  owner         User? @relation("TicketOwner", fields: [ticketOwnerId], references: [id])
  category      Category             @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem        @relation(fields: [relatedSystemId], references: [id])

  attachments Attachment[]
  publicComments PublicComment[]
  internalNotes InternalNote[]
  actions ActionTaken[]

  @@index([requesterId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([ticketOwnerId])
  @@index([updatedAt])
}

// ---------------------------------------------------------------------------
// Lab 2 — Attachment (soft removal via removedAt)
// ---------------------------------------------------------------------------
model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storedFilename   String    @unique
  mimeType         String
  sizeBytes        Int
  removedAt        DateTime?
  removedReason    String?   @db.Text
  createdAt        DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([removedAt])
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requestedTickets Ticket[]        @relation("TicketRequester")
  ownedTickets     Ticket[]        @relation("TicketOwner")
  sessions         Session[]
  publicComments   PublicComment[]
  internalNotes    InternalNote[]
  recordedActions  ActionTaken[]   @relation("ActionRecorder")
  assignedActions  ActionTaken[]   @relation("ActionAssignee")
  actionEvents     ActionTakenEvent[] @relation("ActionEventActor")

  @@index([isActive])
  @@index([role])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Lab 4 — ActionTaken (mutable current state) + ActionTakenEvent (append-only
// audit history, INSERT-only by application contract — no update/delete API).
// ---------------------------------------------------------------------------
enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionEventType {
  CREATED
  UPDATED
  ASSIGNED
  STATUS_CHANGED
  COMPLETED
  CANCELLED
  FOLLOW_UP_CHANGED
}

model ActionTaken {
  id               Int          @id @default(autoincrement())
  ticketId         Int
  description      String       @db.VarChar(1000)
  result           String?      @db.VarChar(2000)
  performedById    Int
  assignedToId     Int?
  actionDate       DateTime
  followUpRequired Boolean      @default(false)
  followUpNote     String?      @db.VarChar(500)
  attachmentNotes  String?      @db.VarChar(500)
  status           ActionStatus @default(PLANNED)
  cycle            Int
  version          Int          @default(1)
  clientRequestId  String       @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy User               @relation("ActionRecorder", fields: [performedById], references: [id])
  assignedTo  User?              @relation("ActionAssignee", fields: [assignedToId], references: [id])
  events      ActionTakenEvent[]

  @@unique([ticketId, clientRequestId])
  @@index([ticketId])
  @@index([ticketId, status, cycle])
}

model ActionTakenEvent {
  id            Int             @id @default(autoincrement())
  actionTakenId Int
  eventType     ActionEventType
  actorId       Int
  occurredAt    DateTime        @default(now())
  payload       Json
  requestId     String

  action ActionTaken @relation(fields: [actionTakenId], references: [id], onDelete: Cascade)
  actor  User        @relation("ActionEventActor", fields: [actorId], references: [id])

  @@index([actionTakenId])
  @@index([actionTakenId, occurredAt, id])
}
